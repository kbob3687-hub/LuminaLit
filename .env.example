# LLM 配置（OpenAI 兼容接口；PAPERHARNESS_AGENT=auto 且未配齐时回落 FakeLLM）
PAPERHARNESS_LLM_BASE_URL=https://api.deepseek.com
PAPERHARNESS_LLM_API_KEY=sk-your-key-here
PAPERHARNESS_LLM_MODEL=deepseek-flash
PAPERHARNESS_AGENT=auto

# 可选网络加速（宿主机 GitHub 回退镜像 / 沙箱容器内 PyPI 镜像）
PAPERHARNESS_GIT_MIRROR=https://ghfast.top/
PAPERHARNESS_PIP_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
